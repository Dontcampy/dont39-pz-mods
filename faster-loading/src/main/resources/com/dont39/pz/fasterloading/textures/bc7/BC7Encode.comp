uvec4 block_package3(uint part, uint threadBase) {
    uvec4 block;
    block.x = 0x08u | (part << 4)
        | ((get_end_point_l(0).r & 0xFEu) <<  9) | ((get_end_point_h(0).r & 0xFEu) << 16)
        | ((get_end_point_l(1).r & 0xFEu) << 23) | ((get_end_point_h(1).r & 0xFEu) << 30);
    block.y = ((get_end_point_h(1).r & 0xFEu) >>  2) | ((get_end_point_l(0).g & 0xFEu) <<  5)
        | ((get_end_point_h(0).g & 0xFEu) << 12) | ((get_end_point_l(1).g & 0xFEu) << 19)
        | ((get_end_point_h(1).g & 0xFEu) << 26);
    block.z = ((get_end_point_h(1).g & 0xFEu) >>  6) | ((get_end_point_l(0).b & 0xFEu) <<  1)
        | ((get_end_point_h(0).b & 0xFEu) <<  8) | ((get_end_point_l(1).b & 0xFEu) << 15)
        | ((get_end_point_h(1).b & 0xFEu) << 22)
        | ((get_end_point_l(0).r & 0x01u) << 30) | ((get_end_point_h(0).r & 0x01u) << 31);
    block.w = ((get_end_point_l(1).r & 0x01u) <<  0) | ((get_end_point_h(1).r & 0x01u) <<  1)
        | (get_color_index(0) << 2);
    uint i = 1u;
    for (; i <= candidateFixUpIndex1D[part]; i++) {
        block.w |= get_color_index(i) << (i * 2u + 1u);
    }
    for (; i < 16u; i++) {
        block.w |= get_color_index(i) << (i * 2u);
    }
    return block;
}
uvec4 block_package4(uint rotation, uint index_selector, uint threadBase) {
    uvec4 block;
    block.x = 0x10u | ((rotation & 3u) << 5) | ((index_selector & 1u) << 7)
        | ((get_end_point_l(0).r & 0xF8u) <<  5) | ((get_end_point_h(0).r & 0xF8u) << 10)
        | ((get_end_point_l(0).g & 0xF8u) << 15) | ((get_end_point_h(0).g & 0xF8u) << 20)
        | ((get_end_point_l(0).b & 0xF8u) << 25);
    block.y = ((get_end_point_l(0).b & 0xF8u) >>  7) | ((get_end_point_h(0).b & 0xF8u) >>  2)
        | ((get_end_point_l(0).a & 0xFCu) <<  4) | ((get_end_point_h(0).a & 0xFCu) << 10)
        | ((get_color_index(0) & 1u) << 18) | (get_color_index(1) << 19) | (get_color_index(2) << 21)
        | (get_color_index(3) << 23) | (get_color_index(4) << 25) | (get_color_index(5) << 27)
        | (get_color_index(6) << 29) | (get_color_index(7) << 31);
    block.z = (get_color_index(7) >>  1) | (get_color_index(8) <<  1) | (get_color_index(9) <<  3)
        | (get_color_index(10)<<  5) | (get_color_index(11)<<  7) | (get_color_index(12)<<  9)
        | (get_color_index(13)<< 11) | (get_color_index(14)<< 13) | (get_color_index(15)<< 15)
        | ((get_alpha_index(0) & 3u) << 17) | (get_alpha_index(1) << 19) | (get_alpha_index(2) << 22)
        | (get_alpha_index(3) << 25) | (get_alpha_index(4) << 28) | (get_alpha_index(5) << 31);
    block.w = (get_alpha_index(5) >>  1) | (get_alpha_index(6) <<  2) | (get_alpha_index(7) <<  5)
        | (get_alpha_index(8) <<  8) | (get_alpha_index(9) << 11) | (get_alpha_index(10)<< 14)
        | (get_alpha_index(11)<< 17) | (get_alpha_index(12)<< 20) | (get_alpha_index(13)<< 23)
        | (get_alpha_index(14)<< 26) | (get_alpha_index(15)<< 29);
    return block;
}
uvec4 block_package5(uint rotation, uint threadBase) {
    uvec4 block;
    block.x = 0x20u | (rotation << 6)
        | ((get_end_point_l(0).r & 0xFEu) <<  7) | ((get_end_point_h(0).r & 0xFEu) << 14)
        | ((get_end_point_l(0).g & 0xFEu) << 21) | ((get_end_point_h(0).g & 0xFEu) << 28);
    block.y = ((get_end_point_h(0).g & 0xFEu) >>  4) | ((get_end_point_l(0).b & 0xFEu) <<  3)
        | ((get_end_point_h(0).b & 0xFEu) << 10) | (get_end_point_l(0).a << 18) | (get_end_point_h(0).a << 26);
    block.z = (get_end_point_h(0).a >>  6)
        | (get_color_index(0) <<  2) | (get_color_index(1) <<  3) | (get_color_index(2) <<  5)
        | (get_color_index(3) <<  7) | (get_color_index(4) <<  9) | (get_color_index(5) << 11)
        | (get_color_index(6) << 13) | (get_color_index(7) << 15) | (get_color_index(8) << 17)
        | (get_color_index(9) << 19) | (get_color_index(10)<< 21) | (get_color_index(11)<< 23)
        | (get_color_index(12)<< 25) | (get_color_index(13)<< 27) | (get_color_index(14)<< 29)
        | (get_color_index(15)<< 31);
    block.w = (get_color_index(15)>> 1) | (get_alpha_index(0) <<  1) | (get_alpha_index(1) <<  2)
        | (get_alpha_index(2) <<  4) | (get_alpha_index(3) <<  6) | (get_alpha_index(4) <<  8)
        | (get_alpha_index(5) << 10) | (get_alpha_index(6) << 12) | (get_alpha_index(7) << 14)
        | (get_alpha_index(8) << 16) | (get_alpha_index(9) << 18) | (get_alpha_index(10)<< 20)
        | (get_alpha_index(11)<< 22) | (get_alpha_index(12)<< 24) | (get_alpha_index(13)<< 26)
        | (get_alpha_index(14)<< 28) | (get_alpha_index(15)<< 30);
    return block;
}
uvec4 block_package6(uint threadBase) {
    uvec4 block;
    block.x = 0x40u
        | ((get_end_point_l(0).r & 0xFEu) <<  6) | ((get_end_point_h(0).r & 0xFEu) << 13)
        | ((get_end_point_l(0).g & 0xFEu) << 20) | ((get_end_point_h(0).g & 0xFEu) << 27);
    block.y = ((get_end_point_h(0).g & 0xFEu) >>  5) | ((get_end_point_l(0).b & 0xFEu) <<  2)
        | ((get_end_point_h(0).b & 0xFEu) <<  9) | ((get_end_point_l(0).a & 0xFEu) << 16)
        | ((get_end_point_h(0).a & 0xFEu) << 23)
        | (get_end_point_l(0).r & 0x01u) << 31;
    block.z = (get_end_point_h(0).r & 0x01u)
        | (get_color_index(0) <<  1) | (get_color_index(1) <<  4) | (get_color_index(2) <<  8)
        | (get_color_index(3) << 12) | (get_color_index(4) << 16) | (get_color_index(5) << 20)
        | (get_color_index(6) << 24) | (get_color_index(7) << 28);
    block.w = (get_color_index(8) <<  0) | (get_color_index(9) <<  4) | (get_color_index(10)<<  8)
        | (get_color_index(11)<< 12) | (get_color_index(12)<< 16) | (get_color_index(13)<< 20)
        | (get_color_index(14)<< 24) | (get_color_index(15)<< 28);
    return block;
}
uvec4 block_package7(uint part, uint threadBase) {
    uvec4 block;
    block.x = 0x80u | (part << 8)
        | ((get_end_point_l(0).r & 0xF8u) << 11) | ((get_end_point_h(0).r & 0xF8u) << 16)
        | ((get_end_point_l(1).r & 0xF8u) << 21) | ((get_end_point_h(1).r & 0xF8u) << 26);
    block.y = ((get_end_point_h(1).r & 0xF8u) >>  6) | ((get_end_point_l(0).g & 0xF8u) >>  1)
        | ((get_end_point_h(0).g & 0xF8u) <<  4) | ((get_end_point_l(1).g & 0xF8u) <<  9)
        | ((get_end_point_h(1).g & 0xF8u) << 14) | ((get_end_point_l(0).b & 0xF8u) << 19)
        | ((get_end_point_h(0).b & 0xF8u) << 24);
    block.z = ((get_end_point_l(1).b & 0xF8u) >>  3) | ((get_end_point_h(1).b & 0xF8u) <<  2)
        | ((get_end_point_l(0).a & 0xF8u) <<  7) | ((get_end_point_h(0).a & 0xF8u) << 12)
        | ((get_end_point_l(1).a & 0xF8u) << 17) | ((get_end_point_h(1).a & 0xF8u) << 22)
        | ((get_end_point_l(0).r & 0x04u) << 28) | ((get_end_point_h(0).r & 0x04u) << 29);
    block.w = ((get_end_point_l(1).r & 0x04u) >>  2) | ((get_end_point_h(1).r & 0x04u) >>  1)
        | (get_color_index(0) <<  2);
    uint i = 1u;
    for (; i <= candidateFixUpIndex1D[part]; i++) {
        block.w |= get_color_index(i) << (i * 2u + 1u);
    }
    for (; i < 16u; i++) {
        block.w |= get_color_index(i) << (i * 2u);
    }
    return block;
}

shared uint shared_flip[4][2];

void main() {
    if (groupIndex() * 4u >= g_num_total_blocks) {
        return;
    }
    uint GI = gl_LocalInvocationIndex;
    uint blockInGroup = GI / 16u;
    uint blockID = groupIndex() * 4u + blockInGroup;
    uint threadBase = blockInGroup * 16u;
    uint threadInBlock = GI - threadBase;
    uint block_y = blockID / g_num_block_x;
    uint block_x = blockID - block_y * g_num_block_x;
    uint base_x = block_x * 4u;
    uint base_y = block_y * 4u;

    uvec4 inb = g_InBuff[min(blockID, g_num_total_blocks - 1u)];
    uint mode = inb.y & 0x7FFFFFFFu;
    uint part = min(inb.z, 63u);
    uint index_selector = (inb.y >> 31) & 1u;
    uint rotation = inb.w;

    uvec4 pixel0 = loadPixel(base_x, base_y, threadInBlock);
    if (4u == mode || 5u == mode) {
        pixel0 = rotate(pixel0, rotation);
    }
    shared_temp[GI].pixel = pixel0;
    SYNC;

    bool two = (1u == mode || 3u == mode || 7u == mode);
    uint subset_index = two ? (candidateSectionBit[part] >> threadInBlock) & 1u : 0u;

    // each subset's bounding box, subset ii in thread ii
    uvec4 ep[2];
    ep[0] = uvec4(MAX_UINT);
    ep[1] = uvec4(0u);
    uvec4 ep_quantized[2];
    for (uint ii = 0u; ii < 2u; ii++) {
        uvec4 e0 = uvec4(MAX_UINT);
        uvec4 e1 = uvec4(0u);
        if (subset_index == ii) {
            e0 = shared_temp[GI].pixel;
            e1 = e0;
        }
        shared_temp[GI].endPoint_low = e0;
        shared_temp[GI].endPoint_high = e1;
        SYNC;
        for (uint s = 8u; s > 0u; s >>= 1u) {
            if (threadInBlock < s) {
                shared_temp[GI].endPoint_low = min(shared_temp[GI].endPoint_low, shared_temp[GI + s].endPoint_low);
                shared_temp[GI].endPoint_high = max(shared_temp[GI].endPoint_high, shared_temp[GI + s].endPoint_high);
            }
            SYNC;
        }
        if (ii == threadInBlock) {
            ep[0] = shared_temp[threadBase].endPoint_low;
            ep[1] = shared_temp[threadBase].endPoint_high;
        }
        // the next pass overwrites the reduction's result
        SYNC;
    }

    if (threadInBlock < 2u) {
        uvec2 P;
        if (1u == mode) {
            P = uvec2((rotation >> threadInBlock) & 1u);
        } else {
            P = uvec2(rotation >> (threadInBlock * 2u), rotation >> (threadInBlock * 2u + 1u)) & 1u;
        }
        if (1u == mode) compress_endpoints1(ep, P, ep_quantized);
        else if (3u == mode) compress_endpoints3(ep, P, ep_quantized);
        else if (4u == mode) compress_endpoints4(ep, ep_quantized);
        else if (5u == mode) compress_endpoints5(ep, ep_quantized);
        else if (6u == mode) compress_endpoints6(ep, P, ep_quantized);
        else compress_endpoints7(ep, P, ep_quantized);
        shared_temp[GI].endPoint_low = ep[0];
        shared_temp[GI].endPoint_high = ep[1];
        shared_temp[GI].endPoint_low_quantized = ep_quantized[0];
        shared_temp[GI].endPoint_high_quantized = ep_quantized[1];
    }
    SYNC;

    uvec2 indexPrec;
    if (1u == mode) indexPrec = uvec2(1u);
    else if (6u == mode) indexPrec = uvec2(0u);
    else if (4u == mode) indexPrec = (0u == index_selector) ? uvec2(2u, 1u) : uvec2(1u, 2u);
    else indexPrec = uvec2(2u);
    uvec4 e0 = shared_temp[threadBase + subset_index].endPoint_low;
    uvec4 e1 = shared_temp[threadBase + subset_index].endPoint_high;
    uvec4 px = shared_temp[threadBase + threadInBlock].pixel;
    uint color_index;
    uint alpha_index = 0u;
    if (4u == mode || 5u == mode) {
        color_index = bestIndex(px, e0, e1, indexPrec.x, true, false);
        alpha_index = bestIndex(px, e0, e1, indexPrec.y, false, true);
    } else {
        color_index = bestIndex(px, e0, e1, indexPrec.x, true, 6u == mode || 7u == mode);
    }
    // the anchor's top index bit must be 0: else swap the subset's endpoints and mirror its indices (the weights are
    // symmetric, so the colours stay the same)
    uint anchor = subset_index == 0u ? 0u : candidateFixUpIndex1D[part];
    if (threadInBlock == anchor) {
        // bit 0: the colour (or only) index set of this subset, bit 1: the alpha set of modes 4 and 5
        shared_flip[blockInGroup][subset_index] = (color_index >= (8u >> indexPrec.x) ? 1u : 0u)
            | (alpha_index >= (8u >> indexPrec.y) && (4u == mode || 5u == mode) ? 2u : 0u);
    }
    SYNC;
    uint flip = shared_flip[blockInGroup][subset_index];
    if ((flip & 1u) != 0u) color_index = (16u >> indexPrec.x) - 1u - color_index;
    if ((flip & 2u) != 0u) alpha_index = (16u >> indexPrec.y) - 1u - alpha_index;
    if (index_selector != 0u) {
        swapu(color_index, alpha_index);
    }
    shared_temp[GI].error = color_index;
    shared_temp[GI].mode = alpha_index;
    if (threadInBlock < 2u) {
        uint f = shared_flip[blockInGroup][threadInBlock];
        if (4u == mode || 5u == mode) {
            if ((f & 1u) != 0u) {
                uvec3 t = shared_temp[GI].endPoint_low_quantized.rgb;
                shared_temp[GI].endPoint_low_quantized.rgb = shared_temp[GI].endPoint_high_quantized.rgb;
                shared_temp[GI].endPoint_high_quantized.rgb = t;
            }
            if ((f & 2u) != 0u) {
                uint t = shared_temp[GI].endPoint_low_quantized.a;
                shared_temp[GI].endPoint_low_quantized.a = shared_temp[GI].endPoint_high_quantized.a;
                shared_temp[GI].endPoint_high_quantized.a = t;
            }
        } else if ((f & 1u) != 0u) {
            uvec4 t = shared_temp[GI].endPoint_low_quantized;
            shared_temp[GI].endPoint_low_quantized = shared_temp[GI].endPoint_high_quantized;
            shared_temp[GI].endPoint_high_quantized = t;
        }
    }
    SYNC;

    if (0u == threadInBlock && blockID < g_num_total_blocks) {
        uvec4 block;
        if (1u == mode) block = block_package1(part, threadBase);
        else if (3u == mode) block = block_package3(part, threadBase);
        else if (4u == mode) block = block_package4(rotation, index_selector, threadBase);
        else if (5u == mode) block = block_package5(rotation, threadBase);
        else if (6u == mode) block = block_package6(threadBase);
        else block = block_package7(part, threadBase);
        g_OutBuff[blockID] = block;
    }
}
#endif
