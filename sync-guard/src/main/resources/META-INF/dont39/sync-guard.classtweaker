zabric-classtweaker v1
# the mod's packets on the game's main-loop queues, in order with the in-scope packets
accessible field zombie/network/GameServer MainLoopNetDataHighPriorityQ Ljava/util/concurrent/ConcurrentLinkedQueue;
accessible field zombie/network/GameClient MainLoopNetDataQ Ljava/util/concurrent/ConcurrentLinkedQueue;
# refuses a send of the mod inside one of the game's
accessible field zombie/core/raknet/UdpConnection bufferLock Ljava/util/concurrent/locks/Lock;
# the join's connection-details, with the server's trailer at the end
accessible field zombie/gameStates/ConnectToServerState connectionDetails Lzombie/core/network/ByteBufferReader;
