<#-- GlueWriter.PatchView and its parts; ${br} is a space GlueWriter may break the line at. -->
<#macro params ps>
<#list ps as p>
                <@param p/><#if p?has_next>,<#else>) {</#if>
</#list>
</#macro>
<#macro param p>
<#switch p.kind>
<#case "self">
@Patch.This<#t>
<#break>
<#case "arg">
<#if p.positional>
${p.type} ${p.name}<#rt>
<#return>
</#if>
@Patch.Argument(<#if p.writable>value = ${p.index}, readOnly = false<#else>${p.index}</#if>)<#t>
<#break>
<#case "return">
@Patch.Return<#if p.writable>(readOnly = false)</#if><#t>
<#break>
<#case "thrown">
@Patch.Thrown<#t>
<#break>
<#case "local">
@Patch.Local("${p.name}")<#t>
<#break>
</#switch>
 ${p.type} ${p.name}<#rt>
</#macro>
<#macro value p c v>
<#if !v.callback>
<#if v.cast??>(${v.cast}) </#if>${v.name}<#t>
<#elseif c.declared>
ci<#t>
<#elseif c.returnable??>
new CallbackInfoReturnable<${c.returnable}>("${p.method?j_string}", ${c.cancellable?c})<#t>
<#else>
new CallbackInfo("${p.method?j_string}", ${c.cancellable?c})<#t>
</#if>
</#macro>
<#macro guarded p b c>
                try {
<#if c.returned! == "returned">
                    ${c.returnable} returned = null;
                    if (thrown == null) {
                        returned = ret;
                    }
</#if>
<#if c.declared && c.returnable??>
                    CallbackInfoReturnable<${c.returnable}> ci = new CallbackInfoReturnable<>("${p.method?j_string}",${br}${c.cancellable?c}<#if c.returned??>,${br}${c.returned}</#if>);
<#elseif c.declared>
                    CallbackInfo ci = new CallbackInfo("${p.method?j_string}", ${c.cancellable?c});
</#if>
                    <#if c.assign??>${c.assign} = </#if>${b.callee}.${c.handler}(<#list c.values as v><@value p c v/><#sep>,${br}</#list>);
<#if c.cancellable>
                    if (ci.isCancelled()) {
<#if p.nonVoid>
                        <#if c.head>value<#else>ret</#if> = ci.getReturnValue${c.suffix}();
</#if>
<#if c.head>
                        cancelled = true;
                        return true;
<#else>
                        done = true;
</#if>
                    }
</#if>
                } catch (Throwable t) {
                    MOD.failed(${b.gate},${br}"running ${b.hookClass?j_string}.${c.handler?j_string} on ${p.owner?j_string}.${p.method?j_string}",${br}t);
                }
</#macro>
package ${unit.packageName};

import com.pzlauncher.zabric.hook.CallbackInfo;
import com.pzlauncher.zabric.hook.CallbackInfoReturnable;
import com.pzlauncher.zabric.hook.LocalRef;
import com.pzlauncher.zabric.hook.ModHooks;
import com.pzlauncher.zabric.hook.ZabricHooks;
import me.zed_0xff.zombie_buddy.Patch;

// Generated by zabric-processor. Do not edit.
public final class ${unit.className} {
    public static final ModHooks MOD = ZabricHooks.mod("${unit.modId?j_string}");

    private ${unit.className}() {
    }
<#list patches as p>

    @Patch(className = "${p.owner?j_string}", methodName = "${p.method?j_string}", strictMatch = true)
    public static final class ${p.name} {
        private ${p.name}() {
        }

<#if p.cancellable>
        @Patch.OnEnter(skipOn = true)
        public static boolean enter(
<#else>
        @Patch.OnEnter
        public static void enter(
</#if>
<@params p.enterParams/>
<#list p.blocks as b>
            ${b.gateLocal} = <#if b.always>MOD.open()<#else>MOD.active(${b.gate})</#if>;
</#list>
<#list p.blocks as b>
<#if b.heads?has_content || b.shares?has_content>
            if (${b.gateLocal}) {
<#list b.shares as s>
                ${s.local} = LocalRef.create();
</#list>
<#list b.heads as c>
<@guarded p b c/>
</#list>
            }
</#if>
</#list>
<#if p.cancellable>
            return false;
</#if>
        }
<#if p.exit()>

        @Patch.OnExit<#if p.onThrowable>(onThrowable = Throwable.class)</#if>
        public static void exit(
<@params p.exitParams/>
<#if p.hasReturn>
            boolean done = <#if p.cancellable && p.onThrowable>cancelled || thrown != null<#elseif p.cancellable>cancelled<#elseif p.onThrowable>thrown != null<#else>false</#if>;
</#if>
<#if p.restoreValue>
            if (cancelled) {
                ret = value;
            }
</#if>
<#list p.blocks as b>
<#list b.exits as c>
            if (${b.gateLocal}<#if c.afterDone> && !done</#if>) {
<@guarded p b c/>
            }
</#list>
</#list>
        }
</#if>
    }
</#list>
}
